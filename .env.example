# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# Твой Telegram ID (узнать: @userinfobot)
ADMIN_ID=123456789

# URL базы данных (используется внутри Docker-сети)
DATABASE_URL=postgresql+asyncpg://everart:everart_pass@db:5432/everart

# Разрешённые origin для CORS (через запятую)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Публичный URL Mini App (для BotFather / кнопки WebApp)
WEBAPP_URL=https://your-domain.com